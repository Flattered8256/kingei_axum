# 复制为 .env 后给本机 cargo run 用。真正的 .env 不会进 git。
# cp .env.example .env

DATABASE_URL=sqlite://chat.db
PORT=8000
JWT_SECRET=change-me
RUST_LOG=info

# 存储后端：s3（S3 兼容对象存储）或 local（本地磁盘）。缺省 s3。
STORAGE_BACKEND=s3

# 对象存储（STORAGE_BACKEND=s3 时使用）
S3_ENDPOINT=http://127.0.0.1:3900
S3_PUBLIC_ENDPOINT=http://127.0.0.1:3000
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key-dev
S3_BUCKET=kingei
S3_REGION=us-east-1
# S3_PATH_STYLE=true
# S3_MANAGE_BUCKET=true

# 本地磁盘（STORAGE_BACKEND=local 时使用）
# 可选目录，缺省 ./data/files；Docker 里建议 /data/files。
# STORAGE_DIR=/data/files
# 可选。缺省同源相对前缀：STATIC_DIR 非空时为 /api，否则为空。
# 只有前后端真正分域、需要绝对地址时才填。
# STORAGE_PUBLIC_BASE_URL=https://api.example.com
# 可选，缺省复用 JWT_SECRET。
# STORAGE_SECRET=

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 前后端拆开托管时取消注释。本机 pnpm dev 走同源反代时不要填。
# FRONTEND_ORIGIN=https://你的前端域名
# COOKIE_SAMESITE=none


